// yamazitte's own niri tweaks, included from /etc/niri/config.kdl.
// Keep image-wide (not machine-specific) settings here so config.kdl stays
// identical to upstream niri and is easy to diff against new releases.

binds {
    // The stock hotkey-overlay bind is Mod+Shift+Slash, i.e. Mod+? on a US
    // keyboard. niri matches binds against a key's *base* symbol, before
    // Shift is applied. On Latin American (and many other) layouts "/" is
    // Shift+7, so the same physical chord has to be written Mod+Shift+7.
    // The title makes the overlay advertise this combination.
    Mod+Shift+7 hotkey-overlay-title="Show this help" { show-hotkey-overlay; }

    // Ghostty is the image's terminal (installed in 10-niri-noctalia.sh).
    // Upstream config.kdl binds Mod+T to alacritty, which is not installed;
    // binds merge across includes and the later definition of a key wins.
    Mod+T hotkey-overlay-title="Open a Terminal: ghostty" { spawn "ghostty"; }
}

// Bazzite autostarts KDE's "Xwayland Video Bridge" (it lets X11 apps such as
// Discord screen-share on Wayland). Its window is meant to be invisible: KWin
// hides it with a built-in rule, niri has none, so it shows up as a black
// tile. Keep it running, but make it a 1x1 invisible unfocused floating
// window in a corner. Do NOT close it: Discord screen sharing needs it.
window-rule {
    match app-id="^xwaylandvideobridge$"
    open-floating true
    open-focused false
    default-floating-position x=0 y=0 relative-to="bottom-right"
    min-width 1
    max-width 1
    min-height 1
    max-height 1
    opacity 0.0
    focus-ring { off; }
    border { off; }
    shadow { off; }
}

// --- System password prompts open floating, not as a tiled column ----------
//
// niri already floats a new window automatically when either
//   * it has a parent toplevel (that is what an ordinary app dialog is), or
//   * its height is fixed (min height == max height).
// (src/window/mod.rs, compute_open_floating.)
//
// The prompts below satisfy neither. They are separate processes started over
// D-Bus by a daemon -- the keyring, polkit, ssh -- so they have no parent
// window to attach to (the daemon does not even know which app asked), and
// they are resizable. niri therefore tiles them, and a password box ends up
// owning half the screen next to your browser.
//
// There is no generic "float all dialogs" matcher in niri: `match` only takes
// app-id/title and a few state flags, so each prompter needs naming. To find
// the app-id of any window that lands in the wrong place, run
// `niri msg windows` while it is open.
//
// Caveat for your own config: `open-floating` (from any rule, including the
// ones here and niri's fixed-size heuristic) is silently ignored for a window
// that is also pending maximized or fullscreen -- niri puts such windows in
// the tiled layout "where they can do that" (layout/workspace.rs, add_tile).
// So a match-less rule with `open-maximized-to-edges true` or `open-fullscreen
// true` defeats every floating rule in the session: prompts, Steam's toasts and
// the video-bridge window above all become tiled. Prefer oniri (see the bottom
// of this file) to maximise lone windows; if you do want such a rule, give it
// `exclude`s for the floating windows, or set `open-maximized-to-edges false`
// in the floating rules that come after it.
//
// gcr-prompter (package gcr3) is the GNOME keyring's "Authentication required
// / the keyring is locked" box, used by Chrome and every Flatpak that stores
// passwords in the Secret Service.
window-rule {
    match app-id="^gcr-prompter$"
    open-floating true
}

// KDE's polkit agent (spawned below) and KDE's Secret Service prompt. Qt names
// windows either after the binary or after the desktop file, so these patterns
// are deliberately unanchored at the front to match both spellings
// (polkit-kde-authentication-agent-1 and org.kde.polkit-kde-authentication-agent-1).
window-rule {
    match app-id="polkit-kde-authentication-agent-1$"
    match app-id="secretprompter$"
    open-floating true
}

// Unlock KWallet at login, for the KDE apps that talk to kwalletd directly
// (Dolphin's saved network shares, KDE PIM). pam_kwallet_init hands kwalletd
// the login password that pam_kwallet5.so captured during PAM auth.
//
// Note what this is NOT: the Secret Service (org.freedesktop.secrets) on this
// image is gnome-keyring, so that is where Chrome, Flatpaks and anything using
// the secrets portal put their passwords -- see gnome-keyring-pam in
// build_files/10-niri-noctalia.sh for how that one gets unlocked.
// Plasma Login Manager's PAM stack already lists pam_kwallet5.so for every
// session it starts, niri included, so this line is a cheap safety net rather
// than the thing that makes KWallet work.
spawn-at-startup "/usr/libexec/pam_kwallet_init"

// Polkit authentication agent. When an app asks for admin rights (Discover
// installing a Flatpak, `pkexec`, GParted, NetworkManager storing a Wi-Fi
// password...) polkit looks for an *agent* registered in the session to draw
// the password dialog. Plasma autostarts KDE's agent, but its autostart entry
// says OnlyShowIn=KDE, so under niri nobody registers and those requests just
// hang or fail with no dialog. Noctalia has an agent of its own, but it is off
// by default ([shell] polkit_agent = false) and has no system-wide config the
// image could set. So run KDE's: it is already on the image and, thanks to
// /etc/environment.d/50-yamazitte-qt.conf, drawn with the KDE theme.
// polkit accepts ONE agent per session, and an include can add nodes but not
// remove this one, so leave Noctalia's agent off unless you also stop using
// this file (i.e. you keep your own full ~/.config/niri/config.kdl).
spawn-at-startup "/usr/libexec/kf6/polkit-kde-authentication-agent-1"

// Tip: to autostart something that lives in the tray, wrap it so it waits for
// Noctalia's tray to exist (see /usr/bin/tray-launch), e.g. Discord (installed
// by the image via /usr/share/flatpak/preinstall.d/yamazitte.preinstall):
// spawn-at-startup "tray-launch" "flatpak" "run" "com.discordapp.Discord" "--start-minimized"

// oniri (build_files/15-niri-extras.sh): a window that is alone on its
// workspace fills the monitor instead of sitting in a half-width column with
// empty space beside it. -T un-maximises it again when a second window opens,
// so two windows tile as usual. Options need spawn-sh-at-startup.
spawn-sh-at-startup "oniri -T"

