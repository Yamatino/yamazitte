// yamazitte's own niri tweaks, included from /etc/niri/config.kdl.
// Keep image-wide (not machine-specific) settings here so config.kdl stays
// identical to upstream niri and is easy to diff against new releases.

binds {
    // The stock bind for the hotkey overlay is Mod+Shift+Slash. On Latin
    // American (and other) layouts "/" is itself Shift+7: XKB consumes the
    // Shift to produce the "slash" keysym, so niri sees Mod+Slash and the
    // stock bind never fires. Mod+Slash works on those layouts AND on US
    // (where it is just Mod+/). The title makes the overlay list this
    // combination instead of the stock one.
    Mod+Slash hotkey-overlay-title="Show this help" { show-hotkey-overlay; }
}

// Bazzite autostarts KDE's "Xwayland Video Bridge" (it lets X11 apps such as
// Discord screen-share on Wayland). Its window is meant to be invisible: KWin
// hides it with a built-in rule, niri has none, so it shows up as a black
// tile. Keep it running, but make it a 1x1 invisible unfocused floating
// window in a corner. Do NOT close it: Discord screen sharing needs it.
window-rule {
    match app-id="^xwaylandvideobridge$"
    open-floating true
    open-focused false
    default-floating-position x=0 y=0 relative-to="bottom-right"
    min-width 1
    max-width 1
    min-height 1
    max-height 1
    opacity 0.0
    focus-ring { off; }
    border { off; }
    shadow { off; }
}

// Steam draws its own notification toasts as small X11 windows instead of
// using the desktop notification daemon. niri opens them as floating windows,
// which by default appear at the center of the screen. Park them in the
// bottom-right corner and don't let them steal focus from whatever you're doing.
// Source: https://github.com/niri-wm/niri/wiki/Application-Issues#steam
window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}
