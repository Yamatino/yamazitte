#!/usr/bin/env bash
# tray-launch PROGRAM [ARGS...]
#
# Start PROGRAM only once the system tray exists. Apps that autostart with
# niri (Steam, Discord, Telegram...) race against Noctalia: if they come up
# before its tray is registered on D-Bus they end up with no tray icon, or
# show a window they would otherwise have minimised to the tray.
#
# The tray is the "StatusNotifierWatcher" D-Bus service (KDE's protocol,
# which Noctalia implements). `gdbus wait` blocks until it appears.
#
# Use from niri config:   spawn-at-startup "tray-launch" "steam" "-silent"
# Idea from https://github.com/DataLabTechTV/dltos
set -euo pipefail

if [[ $# -lt 1 || "$1" == "-h" || "$1" == "--help" ]]; then
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    [[ $# -lt 1 ]] && exit 1 || exit 0
fi

# Give up after 30 s so a missing tray can never block the program forever.
gdbus wait --session --timeout 30 org.kde.StatusNotifierWatcher || true
exec "$@"
